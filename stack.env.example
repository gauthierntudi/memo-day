# Variables à coller dans Portainer → Stacks → Environment variables
# Portainer UI : https://dailysitereport.parkland.lan:9443
#
# Application (après déploiement) :
#   http://dailysitereport.parkland.lan:3000
#   ou http://192.168.90.213:3000
#
# Si l'app est derrière un reverse proxy HTTPS (ex. https://dailysitereport.parkland.lan) :
#   COOKIE_SECURE=true

POSTGRES_DB=dailysitereport
POSTGRES_USER=parkland
POSTGRES_PASSWORD=ChangeMe-Strong-Password-123!
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
APP_PORT=3000
COOKIE_SECURE=false
