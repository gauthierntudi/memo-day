# Copy to stack.env on the server
#
# Windows Server 2019 (Docker in Windows mode — no Linux containers):
#   powershell -ExecutionPolicy Bypass -File .\scripts\deploy-windows-native.ps1
#
# Linux Docker available:
#   powershell -ExecutionPolicy Bypass -File .\scripts\deploy-windows-docker.ps1
#
# App: http://dailysitereport.parkland.lan:3000
#
# PostgreSQL setup (run once as postgres superuser via psql):
#   CREATE USER dailyuser WITH PASSWORD 'your-password';
#   CREATE DATABASE dailysitereportdb OWNER dailyuser;
#   \c dailysitereportdb
#   GRANT ALL ON SCHEMA public TO dailyuser;
#   GRANT CREATE ON SCHEMA public TO dailyuser;
#   ALTER SCHEMA public OWNER TO dailyuser;

POSTGRES_DB=dailysitereportdb
POSTGRES_USER=dailyuser
POSTGRES_PASSWORD=parkland@243!

# DATABASE_URL is built automatically by deploy-windows-native.ps1 (password URL-encoded)
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
APP_PORT=3000
COOKIE_SECURE=false
